# Front-end web server: nginx serving the byte-exact static build, with /api
# reverse-proxied to the backend (see deploy/nginx.conf). Assets are copied
# explicitly so nothing outside the front-end (server/, .git, etc.) is exposed.
FROM nginx:1.27-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

COPY index.html /usr/share/nginx/html/
COPY assets   /usr/share/nginx/html/assets
COPY archive  /usr/share/nginx/html/archive
COPY bg       /usr/share/nginx/html/bg
COPY frames   /usr/share/nginx/html/frames
COPY tex      /usr/share/nginx/html/tex
COPY sounds   /usr/share/nginx/html/sounds
COPY bull.png lighttext.png text.png origin.png herobg.png dex.webp lightbg.jpeg /usr/share/nginx/html/
