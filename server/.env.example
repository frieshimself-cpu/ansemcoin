# Copy to .env (or set these in your host's environment) before deploying.

# Port the API listens on. In production nginx proxies api.bullrunn.fun -> this.
PORT=8787

# Secret used to sign auth tokens (HS256). MUST be set to a long random string
# in production — otherwise sessions can be forged. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Where the JSON database + seed live. Defaults to ./data next to the server.
# DATA_DIR=/var/lib/bullrun
