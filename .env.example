# Copy to .env (docker-compose reads it automatically). ./deploy.sh creates this
# for you with a freshly generated secret if it's missing.

# Secret used to sign auth tokens. MUST be a long random string in production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the site is served on (host side). Default 80.
# WEB_PORT=80
